CenterShadow.y = logo.y + 72;
CenterShadow_sprite = Sprite(CenterShadow);
CenterShadow_sprite.SetOpacity(1);
CenterShadow_sprite.SetPosition(CenterShadow.x, CenterShadow.y, 7);

// Initializing variables for spinner animation control
time = 0;
acceleration = 0.0010; // The meaning of acceleration and deceleration of the spinner
max_speed = 0.20; // Maximum allowable rotation speed
min_speed = 0.05; // Minimum rotation speed
current_speed = max_speed; // // Initial speed for shutdown and reboot modes
boot_current_speed = 0; // Initial speed for boot mode
theta = 0; // Spinner rotation angle
state = "decelerating"; // Start with deceleration for shutdown and reboot modes
state_boot = "accelerating"; // Start with acceleration for boot mode
/*-------------------------------------------------------------------------------*\
|                               REFRESH CALLBACK                                  |
\*-------------------------------------------------------------------------------*/
fun refresh_callback ()
{
  if (Plymouth.GetMode() == "shutdown" || Plymouth.GetMode() == "reboot") {
    time++; // Incrementing the time counter

    // Handling deceleration state
    if (state == "decelerating") {
      if (current_speed > min_speed) {
        current_speed -= acceleration; // Decreasing the rotation speed
      } else {
        current_speed = min_speed; // Set to minimum speed
        state = "min_speed"; // Transition to maintaining minimum speed state
      }
    }

    theta += current_speed; // Changing the rotation angle of the spinner

    spinner_sprite.SetImage(spinner_image.Rotate(theta)); // Applying rotation to the spinner image
    spinner_sprite2.SetImage(spinner_image2.Rotate(theta));
    FanCenter_sprite.SetImage(FanCenter.Rotate(theta));

    LedRed.opacity_angle += ((2 * 3.14) / 10) * 0.1;  // 0.5 HZ
    min_opacity = 0;
    opacity = (Math.Cos(LedRed.opacity_angle) + 1) / 2;
    opacity *= 1 - min_opacity;
    opacity += min_opacity;
    LedRed.x = boot_x + backdrop.GetWidth() / 2 - LedRed.GetWidth() / 2;
    LedRed.y = boot_y + 30;
    LedRed_sprite.SetZ(9);
    LedRed_sprite.SetOpacity(opacity);
  } else if (Plymouth.GetMode() == "boot") {
    time++; // Incrementing the time counter

    // Handling acceleration state
    if (state_boot == "accelerating") {
      if (boot_current_speed < max_speed) {
        boot_current_speed += acceleration; // Increasing the rotation speed
      } else {
        boot_current_speed = max_speed; // Set to maximum speed
        state_boot = "max_speed"; // Transition to maintaining maximum speed state
      }
    } else if (state_boot == "decelerating") {
      if (boot_current_speed > 0) {
        boot_current_speed -= acceleration; // Decreasing the rotation speed
      } else {
        boot_current_speed = 0; // Stop rotation
      }
    }

    theta += boot_current_speed; // Changing the rotation angle of the spinner

    spinner_sprite.SetImage(spinner_image.Rotate(theta)); // Applying rotation to the spinner image
    spinner_sprite2.SetImage(spinner_image2.Rotate(theta));
    FanCenter_sprite.SetImage(FanCenter.Rotate(theta));

    LedRed.opacity_angle += ((2 * 3.14) / 10) * 0.1;  // 0.5 HZ
    min_opacity = 0;
    opacity = (Math.Cos(LedRed.opacity_angle) + 1) / 2;
    opacity *= 1 - min_opacity;
    opacity += min_opacity;
    LedRed.x = boot_x + backdrop.GetWidth() / 2 - LedRed.GetWidth() / 2;
    LedRed.y = boot_y + 30;
    LedRed_sprite.SetZ(9);
    LedRed_sprite.SetOpacity(opacity);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);
