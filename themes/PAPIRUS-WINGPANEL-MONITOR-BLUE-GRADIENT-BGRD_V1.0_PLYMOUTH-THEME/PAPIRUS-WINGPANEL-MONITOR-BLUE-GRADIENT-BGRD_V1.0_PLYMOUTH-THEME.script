//spinner_sprite.SetX((screen_width - spinner_image.GetWidth()) / 2); // Centering the spinner horizontally
spinner_sprite.SetX(logo.x + 10);
//spinner_sprite.SetY((screen_height - spinner_image.GetHeight()) / 2); // Positioning the spinner vertically on the screen
spinner_sprite.SetY(logo.y + 10);
spinner_sprite.SetZ(3); // Setting the Z-coordinate (depth) of the sprite

// Creating a sprite for the second spinner and setting its properties
spinner_sprite2 = Sprite(spinner_image2);
spinner_sprite2.SetOpacity(1);
spinner_sprite2.SetX(logo.x + 10);
spinner_sprite2.SetY(logo.y + 16); // Change this value to position the second spinner
spinner_sprite2.SetZ(2);

FanCenter = Image("FAN-CENTER.PNG");
FanCenter.x = logo.x + 65;
FanCenter.y = logo.y + 65;
FanCenter_sprite = Sprite(FanCenter);
FanCenter_sprite.SetOpacity(1);
FanCenter_sprite.SetPosition(FanCenter.x, FanCenter.y, 8);

CenterShadow = Image("CENTER-SHADOW.PNG");
