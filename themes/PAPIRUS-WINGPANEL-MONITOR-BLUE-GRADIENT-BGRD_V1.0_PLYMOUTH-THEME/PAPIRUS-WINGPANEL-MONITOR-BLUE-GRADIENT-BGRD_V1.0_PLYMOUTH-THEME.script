// Loading spinner image
spinner_image = Image("FAN.PNG");
spinner_image2 = Image("FAN-SHADOW.PNG");

screen_width = Window.GetWidth();
screen_height = Window.GetHeight();

// Creating a sprite for the spinner and setting its properties
spinner_sprite = Sprite(spinner_image);
