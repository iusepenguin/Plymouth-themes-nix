[Plymouth Theme]
Name=PAPIRUS-WINGPANEL-MONITOR-GRAY-BGRD-4K_V1.0_PLYMOUTH-THEME
Description=This Plymouth theme is an adaptation of the "Wingpanel Monitor" icon (com.github.plugarut.wingpanel-monitor.svg) from the “Papirus” icon set.
ModuleName=script

[script]
ImageDir=/usr/share/plymouth/themes/PAPIRUS-WINGPANEL-MONITOR-GRAY-BGRD-4K_V1.0_PLYMOUTH-THEME
ScriptFile=/usr/share/plymouth/themes/PAPIRUS-WINGPANEL-MONITOR-GRAY-BGRD-4K_V1.0_PLYMOUTH-THEME/PAPIRUS-WINGPANEL-MONITOR-GRAY-BGRD-4K_V1.0_PLYMOUTH-THEME.script
